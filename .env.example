# WeNaija — environment template.
# Copy to .env.local and fill in. Never commit real values.
# Full provisioning guide: docs/03-engineering/accounts-and-services.md

# --- Waitlist delivery (the only live integration in this prototype) ---------
# Without these the API validates each signup and logs it server-side, but does
# not email anyone. The prototype is fully usable without them.
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM_ADDRESS="WeNaija <no-reply@wenaija.ng>"
WAITLIST_TO_EMAIL=hello@wenaija.ng

# --- Everything below is for the platform build, not this prototype ---------
# Listed so the shape is visible now. See the provisioning doc for what each
# account is, how to create it, and which service issues the value.

# Public — compiled into the browser bundle. Nothing secret may live here.
# NEXT_PUBLIC_API_URL=https://api.wenaija.ng
# NEXT_PUBLIC_CDN_URL=https://cdn.wenaija.ng
# NEXT_PUBLIC_FCM_VAPID_PUBLIC_KEY=
# NEXT_PUBLIC_SENTRY_DSN=

# Database — MongoDB Atlas (M10+ in production, for backups)
# MONGODB_URI=

# AWS — S3 media, CloudFront delivery, ElastiCache Redis
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_MEDIA=
# CLOUDFRONT_DOMAIN=
# REDIS_URL=

# SMS — Africa's Talking. Caps are launch-blocking (NFR-14): SMS is the one
# line item that can produce a surprise bill.
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=WeNaija
# SMS_RELAY_THRESHOLD_SECONDS=90
# SMS_DAILY_CAP_PER_USER=5
# SMS_DAILY_CAP_GLOBAL=

# Push — Firebase Cloud Messaging
# FCM_SERVICE_ACCOUNT_JSON=

# App
# JWT_SECRET=
# JWT_REFRESH_SECRET=
